generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  plan             Plan    @default(FREE)
  // BYOK: the user's own provider key, encrypted with a master key from env.
  // The backend stores ciphertext only; plaintext never persisted (spec §6).
  byokKeyEncrypted String? @map("byok_key_encrypted")
  uiTheme          Int     @default(1) @map("ui_theme")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  usageRecords DailyUsage[]
  saves        Save[]
  settingPacks UserSettingPack[]
  wishes       Wishlist[]

  @@map("users")
}

model DailyUsage {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  turns     Int      @default(0)
  // Advanced-tier sub-quota counters (Opus → Sonnet → Gemini Pro downgrade chain).
  // Live here, not on users, so they reset per day with the same atomic pattern.
  opusTurns   Int    @default(0) @map("opus_turns")
  sonnetTurns Int    @default(0) @map("sonnet_turns")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_usage")
}

model World {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  introText    String   @map("intro_text")
  systemPrompt String   @map("system_prompt")
  modelFree    String   @map("model_free")
  modelPaid    String   @map("model_paid")
  saveTemplate Json?    @map("save_template")
  isActive     Boolean  @default(false) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  saves        Save[]
  settingPacks UserSettingPack[]

  @@map("worlds")
}

// Patch-style setting pack: private additions a player layers onto an existing
// world (not a self-authored world). One pack per (user, world). DB enforces
// length caps via VarChar; stricter app-layer limits + content filtering live
// in the AI route (spec §4 / step 4).
model UserSettingPack {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  worldId          String   @map("world_id")
  playerBackground String?  @map("player_background") @db.VarChar(1000)
  customCharacters String?  @map("custom_characters") @db.VarChar(2000)
  termDictionary   String?  @map("term_dictionary")   @db.VarChar(2000)
  difficulty       String?  @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id])

  @@unique([userId, worldId])
  @@map("user_setting_packs")
}

// Wishlist: admin-only. Players submit; only the operator sees entries. There is
// intentionally no public/listing endpoint that exposes who wished for what.
// userId is optional (anonymous wishes allowed) and kept only to notify the
// requester if their world later ships.
model Wishlist {
  id        String         @id @default(uuid())
  userId    String?        @map("user_id")
  topic     String         @db.VarChar(100)
  content   String         @db.VarChar(2000)
  status    WishlistStatus @default(RECEIVED)
  createdAt DateTime       @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("wishlist")
}

enum WishlistStatus {
  RECEIVED      // 已收到（預設）
  IN_PRODUCTION // 製作中
  PUBLISHED     // 已上架
  DECLINED      // 暫不考慮
}

model Save {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  worldId     String   @map("world_id")
  kind        SaveKind @default(MANUAL)
  label       String   @default("存檔")
  contentJson Json?    @map("content_json")  // structured fields per world saveTemplate (manual saves)
  rendered    String?                        // zh-TW plain-text recap shown to the player
  recentTurns Json     @map("recent_turns")  // last N raw turns kept for context restore

  // Zero-knowledge client-side encryption (spec §6) — populated in a later phase.
  ciphertextB64  String? @map("ciphertext_b64")
  ivB64          String? @map("iv_b64")
  wrappedKeyB64  String? @map("wrapped_key_b64")
  recoveryKeyB64 String? @map("recovery_key_b64")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id])

  @@index([userId, worldId])
  @@map("saves")
}

enum SaveKind {
  MANUAL
  AUTO
}

enum Plan {
  FREE
  MID
  ADVANCED
}
